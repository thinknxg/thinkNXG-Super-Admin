# chmod 600 .env  -- never commit the real file.
KEYCLOAK_VERSION=            # the exact version you validated with tools/keycloak/smoke_test.py
POSTGRES_VERSION=            # a supported major version, e.g. the one you run elsewhere
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=           # long random value
KC_PUBLIC_HOST=sso.example.com
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD= # long random value, used once
# KC_PROXY_TRUSTED_ADDRESSES=172.29.0.0/24   # the compose network; change only if you change the subnet
